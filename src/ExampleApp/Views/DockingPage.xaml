<UserControl x:Class="ExampleApp.Views.DockingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dock="clr-namespace:AvalonDock;assembly=AvalonDock"
             xmlns:layout="clr-namespace:AvalonDock.Layout;assembly=AvalonDock"
             xmlns:theme="clr-namespace:AvalonDock.Themes.WPFUI;assembly=AvalonDock.Themes.WPFUI">
    <dock:DockingManager x:Name="Manager">
        <dock:DockingManager.Theme><theme:WPFUITheme /></dock:DockingManager.Theme>
        <layout:LayoutRoot>
            <layout:LayoutRoot.LeftSide>
                <layout:LayoutAnchorSide>
                    <layout:LayoutAnchorGroup>
                        <layout:LayoutAnchorable Title="Toolbox" ContentId="classic-toolbox" AutoHideMinWidth="220">
                            <ListBox Margin="8" BorderThickness="0" Background="Transparent">
                                <ListBoxItem Content="Button" />
                                <ListBoxItem Content="TextBlock" />
                                <ListBoxItem Content="TreeView" />
                            </ListBox>
                        </layout:LayoutAnchorable>
                        <layout:LayoutAnchorable Title="Properties" ContentId="classic-properties" AutoHideMinWidth="220">
                            <TextBlock Margin="16" Text="Name: Document 1" />
                        </layout:LayoutAnchorable>
                    </layout:LayoutAnchorGroup>
                </layout:LayoutAnchorSide>
            </layout:LayoutRoot.LeftSide>
            <layout:LayoutPanel Orientation="Horizontal">
                <layout:LayoutPanel Orientation="Vertical">
                    <layout:LayoutDocumentPaneGroup>
                        <layout:LayoutDocumentPane>
                            <layout:LayoutDocument Title="Document 1" ContentId="classic-document-1">
                                <TextBlock Margin="24" Text="Document 1" />
                            </layout:LayoutDocument>
                            <layout:LayoutDocument Title="Document 2" ContentId="classic-document-2">
                                <TextBlock Margin="24" Text="Document 2" />
                            </layout:LayoutDocument>
                        </layout:LayoutDocumentPane>
                    </layout:LayoutDocumentPaneGroup>
                    <layout:LayoutAnchorablePane DockHeight="160" DockMinHeight="80">
                        <layout:LayoutAnchorable Title="Output" ContentId="classic-output">
                            <TextBlock Margin="16" Text="Build succeeded." />
                        </layout:LayoutAnchorable>
                        <layout:LayoutAnchorable Title="Errors" ContentId="classic-errors">
                            <TextBlock Margin="16" Text="No errors." />
                        </layout:LayoutAnchorable>
                    </layout:LayoutAnchorablePane>
                </layout:LayoutPanel>
                <layout:LayoutAnchorablePane DockWidth="300" DockMinWidth="180">
                    <layout:LayoutAnchorable Title="Solution Explorer" ContentId="classic-explorer">
                        <TreeView Padding="8" BorderThickness="0" Background="Transparent">
                            <TreeViewItem Header="ExampleApp" IsExpanded="True">
                                <TreeViewItem Header="App.xaml" />
                                <TreeViewItem Header="MainWindow.xaml" />
                            </TreeViewItem>
                        </TreeView>
                    </layout:LayoutAnchorable>
                    <layout:LayoutAnchorable Title="Git" ContentId="classic-git">
                        <TextBlock Margin="16" Text="No changes." />
                    </layout:LayoutAnchorable>
                </layout:LayoutAnchorablePane>
            </layout:LayoutPanel>
        </layout:LayoutRoot>
    </dock:DockingManager>
</UserControl>